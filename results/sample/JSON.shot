 "config": {
  "sql_dialect": "Spark SQL style (+ DuckDB shims in sql/00), run on DuckDB; Databricks skipped (workspace quota)",
  "window": "rides started 2025-10-01 00:00 to 2026-09-30 23:59 Chicago local time (12 monthly Divvy files 202510-202609)",
  "grain": "fact_ride = one valid ride; agg_daily = date x rider type x bike type; agg_station_month = start station x month x rider type",
  "dedupe_rule": "identical rows across monthly files collapsed (35 rides at the Apr/May 2026 boundary), then one row per ride_id",
  "validity_rule": "60 s <= duration <= 24 h, end location recorded, inside the service-area box (lat 41.60-42.10, lng -87.95..-87.50), not a test/depot station, straight-line speed <= 45 km/h, started inside the window",
  "dst_rule": "29 rides in the repeated 01:xx hour of 2025-11-02 (DST end) had ended_at < started_at: +3600 s",
  "station_rule": "stations keyed by standardised name (trim, drop trailing '*', collapse spaces); coordinates = median precise ride coordinates; station_key 0 = dockless e-bike start/end",
  "weather": "Open-Meteo historical archive, daily, Loop grid cell (41.8781, -87.6298), America/Chicago days",
  "sample_rule": "data/raw: ride_id ending in '00' (1/256) + every edge-case ride (duplicates, DST, test stations, spill-over, out-of-area, speed); scripts/make_sample.py"
 },
